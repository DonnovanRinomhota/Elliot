# Every environment variable the dashboard reads. Values live in Vercel
# (project elliot-real-estate -> Settings -> Environment Variables), never here.
# Copy to .env.local for local development.
#
# GitHub Actions fails if the code reads a variable that isn't listed here.

# ── Required ────────────────────────────────────────────────
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails that may open the control panel (two-step sign-in required).
ADMIN_EMAILS=
# Same value as n8n's "Elliot Internal Webhook Secret" credential.
ELLIOT_WEBHOOK_SECRET=

# ── n8n webhooks the dashboard calls (production URLs) ──────
# 19 Tenant Onboarding
N8N_ONBOARD_WEBHOOK_URL=
# 08 Knowledge Ingestion
N8N_INGEST_WEBHOOK_URL=
# 17 Manual Send Draft (email)
N8N_SEND_WEBHOOK_URL=
# 28 Manual Send WhatsApp Draft
N8N_SEND_WHATSAPP_WEBHOOK_URL=
# 32 Send WhatsApp Message (a team member's reply)
N8N_SEND_WHATSAPP_MESSAGE_WEBHOOK_URL=
# 30 Cancel Appointment
N8N_CANCEL_APPOINTMENT_WEBHOOK_URL=
# 41 Calendar Access Check
N8N_CALENDAR_CHECK_WEBHOOK_URL=
# 42 ASARI Sync ("Sync now")
N8N_ASARI_SYNC_WEBHOOK_URL=
# 33 Health Check test alert. Optional: worked out from N8N_ONBOARD_WEBHOOK_URL.
N8N_HEALTH_TEST_WEBHOOK_URL=

# Older names for four of the above, still read if the new one is missing.
# Rename them in Vercel when convenient (NEXT_PUBLIC_ is not needed: these are
# only read on the server).
NEXT_PUBLIC_N8N_ONBOARD_WEBHOOK_URL=
NEXT_PUBLIC_N8N_INGEST_WEBHOOK_URL=
NEXT_PUBLIC_N8N_SEND_WEBHOOK_URL=
NEXT_PUBLIC_N8N_SEND_WHATSAPP_WEBHOOK_URL=

# ── Features ────────────────────────────────────────────────
# Listings import: reading files and spreadsheets with Claude.
ANTHROPIC_API_KEY=
# Optional: model and API address (defaults: the model workflow 01 uses, api.anthropic.com).
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
# Listings import from a shared Google Drive folder.
GOOGLE_DRIVE_API_KEY=
# Tests only.
GOOGLE_DRIVE_API_BASE=
# AI cost on the control panel, USD per million tokens (defaults 2 and 10).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Leave unset. "true" shows "Create a business" on the sign-in page.
NEXT_PUBLIC_SELF_SIGNUP_ENABLED=
