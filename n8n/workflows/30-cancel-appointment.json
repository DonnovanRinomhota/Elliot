    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{ encodeURIComponent($json.google_calendar_id) }}/events/{{ encodeURIComponent($json.external_calendar_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "timeout": 20000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1344,
        -288
      ],
      "id": "182fe649-f511-4d0f-82f3-276d02a483df",
      "name": "Delete Calendar Event",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "GbHEZpAP7jofidkz",
          "name": "Elliot Google Calendar"
        }
      },
      "continueOnFail": true,
      "notes": "Same credential and HTTP-node pattern as 12's Delete Orphaned Calendar Event (the native Google Calendar node is unreliable with expressions -- see KNOWN_ISSUES.md)."
    },
    {
      "parameters": {
        "jsCode": "// Delete Calendar Event runs with continueOnFail. Google answers 204 on\n// success, and 410 Gone / 404 if the event was already deleted (e.g. someone\n// removed it straight from Google Calendar) -- that still counts as done.\n// Anything else (expired credential, no access to that calendar) is reported\n// back so the dashboard can tell the user to remove the event by hand.\nconst err = $input.first().json.error;\nlet calendar = 'deleted';\nif (err) {\n  const text = JSON.stringify(err);\n  calendar = /\\b(404|410)\\b|not ?found|has been deleted/i.test(text) ? 'already_gone' : 'failed';\n}\nreturn [{ json: { ...$('Check Appointment').first().json, calendar } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -288
      ],
      "id": "6753c212-b607-4312-b8d1-6281c6e1ff0f",
      "name": "Calendar Result"
    },
    {
      "parameters": {
        "jsCode": "// No Google event to remove: either the tenant has no google_calendar_id, or\n// the appointment was created without one (e.g. inserted by hand).\nreturn [{ json: { ...$input.first().json, calendar: 'no_event' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -96
      ],
      "id": "6d87eb8e-f9eb-4e5a-9dc9-18d7d47c8efc",
      "name": "No Calendar Event"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update appointments\nset status = 'cancelled'\nwhere id = $1::uuid\n  and tenant_id = $2::uuid\n  and status not in ('cancelled', 'completed', 'no_show')\nreturning id, status, $3::text as calendar;",
        "options": {
          "queryReplacement": "={{ [$json.appointment_id, $json.tenant_id, $json.calendar] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1792,
        -192
      ],
      "id": "1e16be1a-3a24-4b82-9035-d4cd98f7c477",
      "name": "Mark Cancelled",
      "credentials": {
        "postgres": {
          "id": "TfAL8Z0epZ1Tqiib",
          "name": "Elliot Postgres (service role)"
        }
      },
      "alwaysOutputData": true,
      "notes": "alwaysOutputData: if the row changed between Load Appointment and here, zero rows come back and Respond Result still answers (409) instead of leaving the webhook hanging. The status change fires the CRM-sync trigger from migration 0026."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.id ? { success: true, appointment_id: $json.id, status: $json.status, calendar: $json.calendar } : { success: false, error: 'the appointment changed while cancelling -- refresh and try again' }) }}",
        "options": {
          "responseCode": "={{ $json.id ? 200 : 409 }}"
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
