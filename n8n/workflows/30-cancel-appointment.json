    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nfor (const f of ['appointment_id', 'tenant_id']) {\n  if (!body[f] || !uuid.test(String(body[f]))) throw new Error(`${f} is required and must be a uuid`);\n}\nreturn [{ json: { appointment_id: String(body.appointment_id), tenant_id: String(body.tenant_id) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -96
      ],
      "id": "018525df-8c52-47b0-a1e4-26a5d2b0a78e",
      "name": "Validate Input"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  (select id from appointments where id = $1::uuid and tenant_id = $2::uuid) as appointment_id,\n  (select status from appointments where id = $1::uuid and tenant_id = $2::uuid) as status,\n  (select external_calendar_id from appointments where id = $1::uuid and tenant_id = $2::uuid) as external_calendar_id,\n  -- 0042: the calendar the viewing was put in (an agent's), else the agency's.\n  coalesce((select nullif(booked_calendar_id, '') from appointments where id = $1::uuid and tenant_id = $2::uuid),\n           (select google_calendar_id from ai_config where tenant_id = $2::uuid)) as google_calendar_id;",
        "options": {
          "queryReplacement": "={{ [$json.appointment_id, $json.tenant_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        448,
        -96
      ],
      "id": "dcc5605f-3927-4fa8-9527-31b96f8dde14",
      "name": "Load Appointment",
      "credentials": {
        "postgres": {
          "id": "TfAL8Z0epZ1Tqiib",
          "name": "Elliot Postgres (service role)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One row always comes back from Load Appointment (scalar subqueries), with\n// NULLs when the appointment doesn't exist for this tenant.\nconst r = $input.first().json;\nconst input = $('Validate Input').first().json;\n\nif (!r.appointment_id) {\n  return [{ json: { ok: false, code: 404, error: 'appointment not found for this tenant' } }];\n}\nif (['cancelled', 'completed', 'no_show'].includes(r.status)) {\n  return [{ json: { ok: false, code: 409, error: `appointment is already ${r.status.replace('_', ' ')}` } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    appointment_id: input.appointment_id,\n    tenant_id: input.tenant_id,\n    google_calendar_id: r.google_calendar_id || null,\n    external_calendar_id: r.external_calendar_id || null,\n    has_event: !!(r.google_calendar_id && r.external_calendar_id),\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -96
      ],
      "id": "17c45aeb-8fb8-4a48-b2c2-2845b66fafe8",
      "name": "Check Appointment"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-can-cancel",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
