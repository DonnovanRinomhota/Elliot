    {
      "parameters": {
        "jsCode": "// Same auto-send rule as 14 (FAQ + confidence >= 0.85 only). Everything else always needs a human.\nconst AUTO_SEND_THRESHOLD = 0.85;\nconst input = $('When Executed by Another Workflow').first().json;\n\nlet draftBody = '';\ntry { draftBody = $json.content[0].text.trim(); } catch (e) { throw new Error('Unexpected Claude draft response shape: ' + JSON.stringify($json)); }\n\nconst category = input.category;\nconst confidence = Number(input.confidence) || 0;\nconst autoSendEligible = category === 'faq_answerable' && confidence >= AUTO_SEND_THRESHOLD;\nconst proposedAppointment = $json.proposed_appointment || null;\n\nreturn [{ json: {\n  tenant_id: input.tenant_id,\n  conversation_id: input.conversation_id,\n  contact_id: input.contact_id,\n  to_wa_id: input.to_wa_id,\n  phone_number_id: input.phone_number_id,\n  wa_message_id: input.wa_message_id,\n  last_inbound_at: input.last_inbound_at,\n  body: draftBody,\n  category,\n  confidence,\n  auto_send_eligible: autoSendEligible,\n  status: 'pending',\n  proposed_appointment: proposedAppointment\n} }];"
      },
