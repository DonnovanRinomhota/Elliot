    {
      "parameters": {
        "jsCode": "// Same grounding rule as 14's FAQ branch, worded for a WhatsApp reply (no subject line, shorter/plainer tone --\n// WhatsApp messages read as texts, not emails).\nconst retrieval = $json.retrieval || $json;\nconst found = retrieval.found;\nconst results = retrieval.results || [];\nconst context = found ? results.map(r => r.content || r.text).join('\\n\\n') : 'No matching knowledge base content was found.';\nconst trigger = $('When Executed by Another Workflow').first().json;\n\nconst prompt = `Draft a short, friendly WhatsApp reply on behalf of a real estate agency.\nAnswer the customer's question ONLY using the knowledge base context below -- do not invent facts.\nIf the context doesn't actually answer the question, say a team member will follow up rather than guessing.\nKeep it conversational and brief, the way a person texts -- no email-style greeting or sign-off, no subject line.\n\nCustomer's WhatsApp message:\n${trigger.body}\n\nKnowledge base context:\n${context}\n\nRespond with ONLY the message text, no JSON, no markdown.`;\n\nreturn [{ json: { ...trigger, prompt } }];"
      },
      "id": "00611deb-7820-45cd-a6d5-962da9353398",
      "name": "Build FAQ Draft Prompt",
      "type": "n8n-nodes-base.code",
