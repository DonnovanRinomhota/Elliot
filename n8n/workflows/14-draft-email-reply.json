    {
      "parameters": {
        "jsCode": "// Extracts draft body text and computes auto_send_eligible.\n// TODO: adjust threshold (0.85) after reviewing real classification confidence in testing.\nconst AUTO_SEND_THRESHOLD = 0.85;\nconst input = $('When Executed by Another Workflow').first().json;\n\nlet draftBody = '';\ntry {\n  draftBody = $json.content[0].text.trim();\n} catch (e) {\n  throw new Error('Unexpected Claude draft response shape: ' + JSON.stringify($json));\n}\n\nconst category = input.category;\nconst confidence = Number(input.confidence) || 0;\nconst autoSendEligible = category === 'faq_answerable' && confidence >= AUTO_SEND_THRESHOLD;\n\n// Carries the confirmed slot (if any) from the scheduling branch through to\n// the saved draft row -- workflow 15 reads this at approval time to decide\n// whether to also call Book Appointment. Comes from $json (Parse Scheduling\n// Result's output) for the scheduling branch; undefined for every other\n// branch, so this correctly defaults to null for FAQ/generic drafts.\nconst proposedAppointment = $json.proposed_appointment || null;\n\nreturn [{\n  json: {\n    tenant_id: input.tenant_id,\n    conversation_id: input.conversation_id,\n    contact_id: input.contact_id,\n    gmail_thread_id: input.gmail_thread_id,\n    gmail_message_id: input.gmail_message_id,\n    to_email: input.from_email,\n    subject: 'Re: ' + (input.subject || ''),\n    body: draftBody,\n    category,\n    confidence,\n    auto_send_eligible: autoSendEligible,\n    status: autoSendEligible ? 'pending' : 'pending', // both start pending; gate decides send path downstream\n    proposed_appointment: proposedAppointment\n  }\n}];;"
      },
