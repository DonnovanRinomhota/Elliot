      "id": "6fbaa835-0ec2-45b0-a111-664ad728f1fb",
      "name": "Execute: Knowledge Retrieval",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true,
      "notes": "TODO: set the real workflow ID for 09 - Knowledge Retrieval."
    },
    {
      "parameters": {
        "jsCode": "// Builds the FAQ-grounded draft prompt using retrieval results.\n// TODO: tune tone/signature to match the tenant's actual brand voice once you have tenant-level config for this.\nconst retrieval = $json.retrieval || $json; // shape depends on 09's actual output\nconst found = retrieval.found;\nconst results = retrieval.results || [];\n\nconst context = found\n  ? results.map(r => r.content || r.text).join('\\n\\n')\n  : 'No matching knowledge base content was found.';\n\nconst prompt = `Draft a professional, concise email reply on behalf of a real estate agency.\nThe customer's question should be answered ONLY using the knowledge base context below -- do not invent facts.\nIf the context doesn't actually answer the question, say the team will follow up with specifics rather than guessing.\n\nCustomer email:\nSubject: ${$('When Executed by Another Workflow').first().json.subject}\nBody: ${$('When Executed by Another Workflow').first().json.body}\n\nKnowledge base context:\n${context}\n\nRespond with ONLY the email body text, no subject line, no JSON, no markdown.`;\n\nreturn [{ json: { ...$('When Executed by Another Workflow').first().json, prompt } }];"
      },
      "id": "fc1abb94-51e5-4e0b-bb83-5bb6512daeb5",
      "name": "Build FAQ Draft Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Builds a generic draft prompt for non-FAQ categories (always goes to human review).\n// TODO: consider category-specific tone (e.g. complaint needs an apologetic, careful tone).\nconst d = $('When Executed by Another Workflow').first().json;\n\nconst prompt = `Draft a professional, concise email reply on behalf of a real estate agency to the message below.\nThis draft will be reviewed by a human before sending, so it's OK to leave placeholders like [confirm availability] if specifics are unknown.\nCategory: ${d.category}\n\nCustomer email:\nSubject: ${d.subject}\nBody: ${d.body}\n\nRespond with ONLY the email body text, no subject line, no JSON, no markdown.`;\n\nreturn [{ json: { ...d, prompt } }];"
      },
      "id": "7b54efe8-6a62-4854-a80b-8a6f4339f689",
      "name": "Build Generic Draft Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"claude-sonnet-4-6\", max_tokens: 600, messages: [ { role: \"user\", content: $json.prompt } ] }) }}",
        "options": {}
      },
      "id": "62f29a8d-f7fe-4aff-aa8c-0b93d7c95cd4",
      "name": "Call Claude (Draft)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        128
      ],
      "credentials": {
        "anthropicApi": {
          "id": "ONpVZEdZ4bnOMO3X",
          "name": "Anthropic account"
        }
      },
      "notes": "Receives input from both branches (FAQ and generic prompt builders)."
    },
    {
      "parameters": {
        "jsCode": "// Extracts draft body text and computes auto_send_eligible.\n// TODO: adjust threshold (0.85) after reviewing real classification confidence in testing.\nconst AUTO_SEND_THRESHOLD = 0.85;\nconst input = $('When Executed by Another Workflow').first().json;\n\nlet draftBody = '';\ntry {\n  draftBody = $json.content[0].text.trim();\n} catch (e) {\n  throw new Error('Unexpected Claude draft response shape: ' + JSON.stringify($json));\n}\n\nconst category = input.category;\nconst confidence = Number(input.confidence) || 0;\nconst autoSendEligible = category === 'faq_answerable' && confidence >= AUTO_SEND_THRESHOLD;\n\nreturn [{\n  json: {\n    tenant_id: input.tenant_id,\n    conversation_id: input.conversation_id,\n    contact_id: input.contact_id,\n    gmail_thread_id: input.gmail_thread_id,\n    gmail_message_id: input.gmail_message_id,\n    to_email: input.from_email,\n    subject: 'Re: ' + (input.subject || ''),\n    body: draftBody,\n    category,\n    confidence,\n    auto_send_eligible: autoSendEligible,\n    status: autoSendEligible ? 'pending' : 'pending' // both start pending; gate decides send path downstream\n  }\n}];"
      },
