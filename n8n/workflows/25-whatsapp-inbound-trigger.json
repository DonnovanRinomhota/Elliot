      "name": "Log Unmatched Number",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -100,
        420
      ],
      "notes": "Improves on 16's known gap (a misconfigured connected_gmail_address silently drops the email with no trace). Here a message for a phone_number_id no tenant has configured is at least logged, not just dropped."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into contacts (tenant_id, phone, name, source)\nvalues ($1, $2, $3, 'whatsapp')\non conflict (tenant_id, phone)\ndo update set phone = excluded.phone,\n              name = coalesce(contacts.name, excluded.name)\nreturning *;",
        "options": {
          "queryReplacement": "={{ [ $('Lookup Tenant by Phone Number Id').first().json.tenant_id, $('Extract WhatsApp Fields').first().json.from_wa_id, $('Extract WhatsApp Fields').first().json.contact_name ] }}"
        }
      },
      "id": "5bf8f29e-2bf4-472b-b78b-1060e61472c5",
      "name": "Upsert Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -100,
        220
      ],
      "notes": "Keeps an existing name rather than overwriting it with WhatsApp's profile name on every message -- a contact who already gave a fuller name via email/chat shouldn't have it clobbered by whatever they set as their WhatsApp display name."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Same pattern as 16's \"Get or Create Conversation (Email)\": one conversation per\n-- (tenant, contact, channel), reused forever, not split by status or thread.\n-- WhatsApp has no thread id to match on the way email has gmail_thread_id --\n-- a contact's phone number IS the thread, so matching on contact_id is enough.\nwith existing as (\n  select id from conversations\n  where tenant_id = $1 and contact_id = $2 and channel = 'whatsapp'\n  limit 1\n),\ninserted as (\n  insert into conversations (tenant_id, contact_id, channel)\n  select $1, $2, 'whatsapp'\n  where not exists (select 1 from existing)\n  returning id\n)\nselect id from existing\nunion all\nselect id from inserted;",
        "options": {
          "queryReplacement": "={{ [ $('Lookup Tenant by Phone Number Id').first().json.tenant_id, $json.id ] }}"
        }
      },
