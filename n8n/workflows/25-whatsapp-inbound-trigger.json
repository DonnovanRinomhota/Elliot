      "id": "44250d65-c9c9-484a-bd9e-547a96116266",
      "name": "WhatsApp Verify (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1400,
        -200
      ],
      "notes": "Meta calls this once when you register the webhook URL in the Meta App dashboard, and again any time you re-verify. Must echo back hub.challenge as plain text if hub.verify_token matches WHATSAPP_VERIFY_TOKEN."
    },
    {
      "parameters": {
        "jsCode": "// Meta's verification handshake: GET ?hub.mode=subscribe&hub.verify_token=...&hub.challenge=...\n// Query params with dots arrive as literal keys (not nested objects) on n8n's webhook node.\nconst q = $json.query || {};\nconst expected = $env.WHATSAPP_VERIFY_TOKEN || '';\nconst ok = q['hub.mode'] === 'subscribe' && expected && q['hub.verify_token'] === expected;\nreturn [{ json: { ok, challenge: q['hub.challenge'] || '' } }];"
      },
      "id": "d6763df3-c5f0-4582-9330-c521b5f3d67d",
      "name": "Check Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -1140,
        -200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1ca8c3c-0787-4353-b7df-63046b0e1a08",
      "name": "Verify OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
