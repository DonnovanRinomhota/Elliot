      "id": "7e9a6e72-d746-4062-a6bd-9f42d20fd0ff",
      "name": "WhatsApp Webhook (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1400,
        200
      ],
      "notes": "Same path as the GET verify node above -- n8n registers them as separate routes because the HTTP method differs. NOT SIGNATURE-VERIFIED YET: Meta signs this body with X-Hub-Signature-256 (HMAC-SHA256 using the Meta App Secret); this workflow doesn't check it, so anyone who discovers this URL could POST a forged message. Same class of gap as the tenant-onboarding webhook -- see KNOWN_ISSUES.md. Add signature verification before relying on this beyond a sandbox test number."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'received' }) }}",
        "options": {}
      },
      "id": "853e46ad-fa4a-4256-8dfb-441e85edfef1",
      "name": "Respond Ack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -1140,
        80
      ],
      "notes": "Meta expects a fast 200 regardless of what's inside -- retries aggressively (and eventually disables the webhook) if it doesn't get one quickly. Responds immediately; processing continues on the other output."
    },
    {
      "parameters": {
        "jsCode": "// Meta's Cloud API webhook shape:\n// { entry: [{ changes: [{ value: { metadata: { phone_number_id }, contacts: [{ profile: { name }, wa_id }], messages: [{ from, id, timestamp, type, text: { body } }] } }] }] }\n// The SAME path also receives delivery/read \"statuses\" updates with no \"messages\" key at all --\n// those aren't a customer message and must be skipped, not treated as an empty one.\n// Non-text messages (image/audio/location/etc.) are also not handled yet -- flagged skip so a caller\n// isn't shown a blank reply. Building real media support (download from Meta's media URL, store it,\n// let Claude look at it) is future work, not done here.\nconst body = $json.body || $json;\nconst value = body?.entry?.[0]?.changes?.[0]?.value;\nconst message = value?.messages?.[0];\n\nif (!value || !message) {\n  return [{ json: { skip: true, reason: !value ? 'no_value' : 'no_message_key_(status_update)' } }];\n}\nif (message.type !== 'text') {\n  return [{ json: { skip: true, reason: 'unsupported_message_type', message_type: message.type,\n                     phone_number_id: value.metadata?.phone_number_id, from: message.from } }];\n}\n\nreturn [{ json: {\n  skip: false,\n  phone_number_id: value.metadata?.phone_number_id || '',\n  from_wa_id: message.from || '',\n  contact_name: value.contacts?.[0]?.profile?.name || null,\n  wa_message_id: message.id || '',\n  message_timestamp: message.timestamp ? new Date(Number(message.timestamp) * 1000).toISOString() : new Date().toISOString(),\n  body: message.text?.body || ''\n} }];"
      },
