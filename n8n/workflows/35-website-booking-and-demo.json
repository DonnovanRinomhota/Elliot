      "parameters": {
        "jsCode": "\n// What the booking page shows: free slots, grouped by day by the page itself.\nconst r = $input.first().json || {};\nconst req = $('Validate Slots Request').first().json;\nconst slots = (r.available_slots || []).slice(0, 120);\nreturn [{ json: { code: 200, body: { success: true, type: req.type, minutes: req.minutes, timezone: r.timezone || 'Europe/Warsaw', slots } } }];\n"
      },
