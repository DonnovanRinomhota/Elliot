      "typeVersion": 2,
      "position": [
        -1200,
        0
      ],
      "notes": "getelliot.eu/book sends the chosen time and the form. Public, validated, honeypot against bots.",
      "webhookId": "36c35b5a-d0a2-5b99-b4b0-5a2c4c776571"
    },
    {
      "parameters": {
        "jsCode": "\nconst TYPES = { intro: { minutes: 15, en: '15-minute intro call', pl: '15-minutowa rozmowa wstępna' },\n                demo: { minutes: 30, en: '30-minute live demo', pl: '30-minutowa prezentacja na żywo' } };\nconst clean = (v, max = 200) => String(v == null ? '' : v).replace(/\\s+/g, ' ').trim().slice(0, max);\nconst EMAIL = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n// POST /webhook/book-consultation from getelliot.eu/book:\n// { type, starts_at, name, email, phone?, agency, agents?, listings?, crm?, message?, lang?, website (honeypot) }\nconst b = $input.first().json.body || {};\nconst fail = (code, error) => [{ json: { ok: false, code, error } }];\nif (clean(b.website)) return fail(400, 'Something went wrong. Please try again.');   // bots fill hidden fields\nconst type = TYPES[b.type] ? b.type : null;\nif (!type) return fail(400, 'Choose an intro call or a live demo.');\nconst start = new Date(b.starts_at);\nif (isNaN(start.getTime())) return fail(400, 'Choose a time.');\nif (start.getTime() < Date.now() + 60 * 60000) return fail(409, 'That time is too soon. Please choose another.');\nconst name = clean(b.name, 120);\nconst email = clean(b.email, 200).toLowerCase();\nconst agency = clean(b.agency, 160);\nif (!name) return fail(400, 'Please enter your name.');\nif (!EMAIL.test(email)) return fail(400, 'Please enter a valid email address.');\nif (!agency) return fail(400, 'Please enter your agency name.');\nconst end = new Date(start.getTime() + TYPES[type].minutes * 60000);\nconst details = { call_type: type, agency, agents: clean(b.agents, 40) || undefined, listings: clean(b.listings, 40) || undefined,\n                  crm: clean(b.crm, 80) || undefined, lang: b.lang === 'pl' ? 'pl' : 'en' };\nreturn [{ json: {\n  ok: true, type, name, email, agency, phone: clean(b.phone, 40), message: clean(b.message, 1000),\n  starts_at: start.toISOString(), ends_at: end.toISOString(), details, details_json: JSON.stringify(details),\n} }];\n"
      },
