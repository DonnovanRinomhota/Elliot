    {
      "parameters": {
        "jsCode": "\n// Tells you (the platform alert email, Control panel → Health & alerts) about\n// a new booking or demo visitor. Sent after the visitor already has their answer.\nconst kind = $('Which Request?').first().json.kind;\nconst lead = kind === 'booking' ? $('Save Booking Lead').first().json : $('Save Demo Lead').first().json;\nconst v = kind === 'booking' ? $('Validate Booking').first().json : $('Validate Demo Access').first().json;\nconst fmt = (iso) => new Date(iso).toLocaleString('en-GB', { timeZone: 'Europe/Warsaw', weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });\nlet subject, lines;\nif (kind === 'booking') {\n  const r = $('Book Via 12').first().json || {};\n  subject = `New ${v.type === 'demo' ? 'live demo' : 'intro call'}: ${v.agency}, ${fmt(v.starts_at)}`;\n  lines = [`${v.name} (${v.email}${v.phone ? ', ' + v.phone : ''}) booked a ${v.type === 'demo' ? '30-minute live demo' : '15-minute intro call'}.`, '',\n    `When: ${fmt(v.starts_at)} (Warsaw)`, r.meet_link ? `Google Meet: ${r.meet_link}` : null,\n    `Agency: ${v.agency}`, v.details.agents ? `Agents: ${v.details.agents}` : null, v.details.listings ? `Listings: ${v.details.listings}` : null,\n    v.details.crm ? `CRM: ${v.details.crm}` : null, v.message ? `Message: ${v.message}` : null, '',\n    'It is in your Google Calendar and in your Elliot dashboard (Appointments, Leads).'];\n} else {\n  subject = `Demo opened: ${v.agency} (${v.name})`;\n  lines = [`${v.name} (${v.email}${v.phone ? ', ' + v.phone : ''}) from ${v.agency} opened the live demo on getelliot.eu.`, '',\n    'They are in your Elliot dashboard under Leads. A good moment to follow up.'];\n}\nconst b64 = (s) => Buffer.from(String(s), 'utf8').toString('base64');\nconst raw = [`To: ${lead.notify_to}`, `Subject: =?UTF-8?B?${b64(subject)}?=`, 'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=UTF-8', 'Content-Transfer-Encoding: base64'].join('\\r\\n') + '\\r\\n\\r\\n' +\n  b64(lines.filter((l) => l !== null).join('\\n') + '\\n');\nreturn [{ json: { to: lead.notify_to, subject, raw_message: Buffer.from(raw).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '') } }];\n"
      },
