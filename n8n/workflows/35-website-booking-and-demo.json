    {
      "parameters": {
        "jsCode": "\nconst TYPES = { intro: { minutes: 15, en: '15-minute intro call', pl: '15-minutowa rozmowa wstępna' },\n                demo: { minutes: 30, en: '30-minute live demo', pl: '30-minutowa prezentacja na żywo' } };\nconst clean = (v, max = 200) => String(v == null ? '' : v).replace(/\\s+/g, ' ').trim().slice(0, max);\nconst EMAIL = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n// GET /webhook/consultation-slots?type=intro|demo[&days=14]\nconst q = ($input.first().json.query || {});\nconst type = TYPES[q.type] ? q.type : 'intro';\nconst days = Math.min(Math.max(parseInt(q.days, 10) || 14, 1), 31);\nconst start = new Date();\nconst end = new Date(start.getTime() + days * 86400000);\nconst ymd = (d) => d.toISOString().slice(0, 10);\nreturn [{ json: { type, minutes: TYPES[type].minutes, date_range_start: ymd(start), date_range_end: ymd(end) } }];\n"
      },
