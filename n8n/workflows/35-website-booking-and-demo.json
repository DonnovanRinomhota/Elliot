    {
      "parameters": {
        "jsCode": "\n// 12's answer -> the booking page. A slot taken a moment ago is 409, so the\n// page reloads the free times.\nconst r = $input.first().json || {};\nconst v = $('Validate Booking').first().json;\nif (r.success) {\n  return [{ json: { code: 200, notify: true, body: {\n    success: true, starts_at: r.starts_at, ends_at: r.ends_at, type: v.type,\n    meet_link: r.meet_link || null, confirmation_sent_to: r.confirmation_sent_to || null,\n  } } }];\n}\nconst taken = /slot_unavailable|no longer available|overlap/i.test(String(r.error || ''));\nreturn [{ json: { code: taken ? 409 : 502, notify: false, body: { success: false,\n  error: taken ? 'Someone just booked that time. Please choose another.' : 'We couldn\\'t book that just now. Please try again or write to hello@getelliot.eu.' } } }];\n"
      },
