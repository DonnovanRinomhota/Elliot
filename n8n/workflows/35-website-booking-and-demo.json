        "jsCode": "// Booking or demo visitor, for the notification email.\nlet kind = 'demo';\ntry { $('Booking Response').first(); kind = 'booking'; } catch (e) { /* demo path */ }\nconst notifyTo = kind === 'booking' ? $('Save Booking Lead').first().json.notify_to : $('Save Demo Lead').first().json.notify_to;\nconst worth = kind === 'booking' ? $('Booking Response').first().json.notify === true : !!$('Save Demo Lead').first().json.demo_slug;\nreturn [{ json: { kind, send: worth && !!notifyTo } }];"
      },
