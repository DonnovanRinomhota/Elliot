    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Replaces the \"Update\" operation entirely -- switch this node's Operation\n-- dropdown to \"Execute Query\" and paste this in as the query. n8n's Postgres\n-- node v2 \"Update\" operation has known parameter-binding bugs (confirmed via\n-- multiple GitHub issues) that can produce this exact confusing failure --\n-- the displayed values look correct but the underlying query is malformed.\n-- Execute Query with explicit parameters bypasses that buggy code path.\n\nupdate email_drafts\nset status = $2,\n    sent_at = $3\nwhere id = $1\nreturning *;",
        "options": {
          "queryReplacement": "={{ [ $('Load Draft').first().json.id, $('When Executed by Another Workflow').first().json.auto ? 'auto_sent' : 'sent', $now.toISO() ] }}"
        }
