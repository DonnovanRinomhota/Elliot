    {
      "parameters": {
        "jsCode": "// Builds the raw RFC 2822 message for Gmail's send API (base64url-encoded), threaded as a reply.\n// TODO: confirm the 'from' address should be the tenant's connected Gmail account, not a hardcoded value.\nconst d = $json;\n\nconst raw =\n  `To: ${d.to_email}\\r\\n` +\n  `Subject: ${d.subject}\\r\\n` +\n  `In-Reply-To: ${d.gmail_message_id}\\r\\n` +\n  `References: ${d.gmail_message_id}\\r\\n` +\n  `Content-Type: text/plain; charset=UTF-8\\r\\n\\r\\n` +\n  `${d.body}`;\n\nconst encoded = Buffer.from(raw).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n\nreturn [{ json: { ...d, raw_message: encoded } }];"
      },
      "id": "c68d9a88-4fee-4f3c-bcb7-96213a722e70",
      "name": "Build Gmail Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        -48
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw: $json.raw_message, threadId: $json.gmail_thread_id }) }}",
        "options": {}
      },
      "id": "794af480-a7a7-4a14-a5cb-6de5824511c1",
