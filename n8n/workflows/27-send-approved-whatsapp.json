    {
      "parameters": {
        "jsCode": "// Meta answers { messages: [{ id }] } when it accepted the template message.\nconst r = $input.first().json;\nconst status = Number(r.statusCode || 0);\nlet body = r.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { /* not JSON */ } }\nconst err = body && typeof body === 'object' ? body.error : null;\nconst ok = status >= 200 && status < 300 && !err;\nlet detail = '';\nif (!ok) {\n  detail = err ? `${err.message || 'refused'}${err.code ? ` (code ${err.code})` : ''}` : `HTTP ${status || 'no response'}`;\n  if (err && Number(err.code) === 132001) detail = `The \"elliot_follow_up\" template isn't approved in WhatsApp yet for this language (${$('Build Follow-Up Template').first().json.language}). ` + detail;\n  if (err && Number(err.code) === 131030) detail += ' -- on the test number, add this phone as an allowed recipient';\n}\nreturn [{ json: { ok, detail: String(detail).slice(0, 400) } }];"
      },
      "id": "d353c82b-8567-58d8-b8cb-da02a413a2b8",
      "name": "Check Template Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
