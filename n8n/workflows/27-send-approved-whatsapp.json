      "parameters": {
        "operation": "executeQuery",
        "query": "-- Same Execute Query workaround as 15's \"Update Draft Status (Sent)\" -- n8n's Postgres v2\n-- \"Update\" operation has known parameter-binding bugs. Don't \"simplify\" this back to it.\nupdate whatsapp_drafts\nset status = $2,\n    sent_at = $3,\n    sent_via = $4,\n    send_error = null\nwhere id = $1\nreturning *;",
        "options": {
          "queryReplacement": "={{ [ $('Load Draft').first().json.id, $('When Executed by Another Workflow').first().json.auto ? 'auto_sent' : 'sent', $now.toISO(), $('Check 24h Window').first().json.within_window ? 'text' : 'template' ] }}"
        }
