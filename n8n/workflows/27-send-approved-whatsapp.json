    {
      "parameters": {
        "jsCode": "// WhatsApp's free-form messaging window: Meta only allows a business to send a plain-text reply\n// within 24 hours of the customer's last message. Outside that window Meta rejects the send\n// (error 131047) unless it's a pre-approved template message -- which isn't built yet (see this\n// workflow's spec). Checked here at SEND time, not draft time, because a human can sit on an\n// approval for longer than 24 hours -- the window may have already closed by the time they click Approve.\nconst d = $json;\nconst hoursSince = (Date.now() - new Date(d.last_inbound_at).getTime()) / 36e5;\nreturn [{ json: { ...d, within_window: hoursSince < 24, hours_since_last_inbound: hoursSince } }];"
      },
      "id": "d707f53f-0de8-48a9-9109-ad0d8072e557",
      "name": "Check 24h Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -820,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.within_window }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cc6e7536-7966-47f2-a547-def01638e2c5",
      "name": "Within 24h Window?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -560,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update whatsapp_drafts set status = 'blocked_needs_template' where id = $1 returning *;",
        "options": {
          "queryReplacement": "={{ [ $('Load Draft').first().json.id ] }}"
        }
      },
      "id": "e1c94215-ff2d-4950-9401-65a9ce7863d1",
      "name": "Update Draft Status (Blocked)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -300,
        160
      ],
      "notes": "Template-message sending (the only legal way to message someone outside the 24h window) isn't built. This just marks the draft so it shows up distinctly in Approvals instead of silently failing or retrying forever -- see docs/workflow-specs/27-send-approved-whatsapp.md."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v20.0/' + $json.phone_number_id + '/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.to_wa_id, type: 'text', text: { body: $json.body } }) }}",
        "options": {}
      },
      "id": "a63c769b-d198-4dc7-8ba6-bfa6524f3fe3",
      "name": "Send via WhatsApp API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -300,
        -140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_CRED_ID",
          "name": "WhatsApp Cloud API token"
        }
      },
      "notes": "TODO: set the real credential -- an HTTP Header Auth credential named e.g. \"WhatsApp Cloud API token\" with header name \"Authorization\" and value \"Bearer <your Meta system-user access token>\". One credential covers every tenant's number (see migration 0025's comment on ai_config.whatsapp_phone_number_id) -- only the URL's phone_number_id needs to vary per tenant, not the token."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Same Execute Query workaround as 15's \"Update Draft Status (Sent)\" -- n8n's Postgres v2\n-- \"Update\" operation has known parameter-binding bugs. Don't \"simplify\" this back to it.\nupdate whatsapp_drafts\nset status = $2,\n    sent_at = $3\nwhere id = $1\nreturning *;",
        "options": {
          "queryReplacement": "={{ [ $('Load Draft').first().json.id, $('When Executed by Another Workflow').first().json.auto ? 'auto_sent' : 'sent', $now.toISO() ] }}"
        }
