    {
      "parameters": {
        "jsCode": "// WhatsApp's free-form messaging window: Meta only allows a business to send plain\n// text within 24 hours of the customer's last message (error 131047 otherwise).\n// Checked here at SEND time, not draft time, because a human can sit on an\n// approval for longer than 24 hours. Outside the window a follow-up goes inside\n// the approved \"elliot_follow_up\" template (0045); any other draft is blocked.\nconst d = $json;\nconst hoursSince = (Date.now() - new Date(d.last_inbound_at).getTime()) / 36e5;\nreturn [{ json: { ...d, within_window: hoursSince < 24, hours_since_last_inbound: hoursSince } }];"
      },
      "id": "d707f53f-0de8-48a9-9109-ad0d8072e557",
      "name": "Check 24h Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -820,
        0
      ]
    },
