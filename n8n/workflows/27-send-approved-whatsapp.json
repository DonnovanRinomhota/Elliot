    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- The draft, plus the names the elliot_follow_up template needs (0045).\nselect d.*,\n       c.name as contact_name,\n       coalesce(nullif(btrim(ac.email_from_name), ''), t.name) as agency_name\nfrom whatsapp_drafts d\njoin tenants t on t.id = d.tenant_id\nleft join contacts c on c.id = d.contact_id\nleft join ai_config ac on ac.tenant_id = d.tenant_id\nwhere d.id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $json.draft_id ] }}"
        }
