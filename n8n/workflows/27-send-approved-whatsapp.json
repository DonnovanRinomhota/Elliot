    {
      "parameters": {
        "jsCode": "// The approved template (WhatsApp Manager → Message templates), two variables:\n//   en: \"Message from {{1}}:\\n\\n{{2}}\\n\\nReply to this message to continue.\"\n//   pl: \"Wiadomość od {{1}}:\\n\\n{{2}}\\n\\nOdpowiedz na tę wiadomość, aby kontynuować.\"\n// WhatsApp refuses template variables with line breaks, tabs or more than four\n// spaces in a row, so the message goes on one line.\nconst d = $('Load Draft').first().json;\nconst flat = (s) => String(s || '').replace(/\\s*[\\r\\n]+\\s*/g, ' ').replace(/\\t/g, ' ').replace(/ {4,}/g, '   ').trim();\nconst text = flat(d.body).slice(0, 900);\nconst agency = flat(d.agency_name || 'your agent').slice(0, 60);\nconst polish = /[ąćęłńśźż]/i.test(d.body) || /\\b(dzień dobry|witam|pozdrawiam|mieszkani|nieruchomoś|oglądani|czy |jeśli|dziękuj)/i.test(d.body);\nconst language = polish ? 'pl' : 'en';\nreturn [{ json: {\n  language,\n  url: 'https://graph.facebook.com/v20.0/' + d.phone_number_id + '/messages',\n  payload: { messaging_product: 'whatsapp', to: d.to_wa_id, type: 'template',\n    template: { name: 'elliot_follow_up', language: { code: language },\n      components: [{ type: 'body', parameters: [{ type: 'text', text: agency }, { type: 'text', text }] }] } },\n} }];"
      },
      "id": "7548e98c-f16e-56a4-9a01-4cb458564a1e",
      "name": "Build Follow-Up Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "52c96fec-bf66-5610-b931-7030975c29bb",
      "name": "Send Follow-Up Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_CRED_ID",
          "name": "WhatsApp Cloud API token"
        }
