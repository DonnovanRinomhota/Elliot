    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.voyageai.com/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: [$json.query], model: 'voyage-4-lite', input_type: 'query' }) }}",
        "options": {}
      },
      "id": "35490791-d8c2-4902-ba39-716ef75701bb",
      "name": "Embed Query (Voyage AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ogmUkMs4GkHYSNLz",
          "name": "Voyage AI API Key (Authorization header)"
        }
      },
      "notes": "Header Auth credential must send 'Authorization: Bearer <key>'. input_type: 'query' vs 'document' matters for Voyage's models -- queries and documents are embedded slightly differently for better retrieval, verify against current Voyage docs."
    },
    {
      "parameters": {
        "jsCode": "// Extract the embedding vector from Voyage's response.\nconst resp = $json;\nconst embedding = resp.data && resp.data[0] && resp.data[0].embedding;\nif (!embedding) { throw new Error('No embedding returned from Voyage AI -- check API key/credits'); }\nconst trigger = $('When Executed by Another Workflow').first().json;\nreturn [{ json: { tenant_id: trigger.tenant_id, query: trigger.query, embedding } }];"
      },
      "id": "d665fc73-b132-4349-8f9d-7afcdcca92b7",
      "name": "Extract Embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from match_document_chunks($1, $2::vector, 5);",
        "options": {
          "queryReplacement": "={{ [$json.tenant_id, JSON.stringify($json.embedding)] }}"
        }
      },
      "id": "422235e7-4ae6-41ac-9fcc-fd4fc8859093",
      "name": "Search Document Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        672,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "TfAL8Z0epZ1Tqiib",
          "name": "Elliot Postgres (service role)"
        }
      },
      "notes": "Uses match_document_chunks RPC from migration 0003 -- tenant_id is a required argument to that function, so this cannot accidentally search across tenants regardless of which Postgres credential executes it."
    },
    {
      "parameters": {
        "jsCode": "// Normalize output shape for the Main Agent's 'Build Tool Result Message' node,\n// which expects each item to have content/document_id/section_ref.\nconst rows = $input.all().map(r => r.json);\n\nif (rows.length === 0) {\n  return [{\n    json: {\n      found: false,\n      message: \"No relevant documents found\",\n      results: []\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    found: true,\n    results: rows.map(r => ({\n      content: r.content,\n      document_id: r.document_id,\n      section_ref: r.section_ref,\n      similarity: r.similarity\n    }))\n  }\n}];"
      },
      "id": "8116472c-2fec-4021-b833-21525f2bb409",
      "name": "Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    }
