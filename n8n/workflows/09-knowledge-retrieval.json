          }
        ]
      ]
    },
    "Extract Embedding": {
      "main": [
        [
          {
            "node": "Search Document Chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Document Chunks": {
      "main": [
        [
          {
            "node": "Format Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
