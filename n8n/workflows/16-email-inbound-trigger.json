      "id": "dbf75273-56d0-4b49-9aa6-0a08e9594d2d",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        -1104,
        64
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "UEVuaDdqEf2Zd7CE",
          "name": "Gmail account"
        }
      },
      "notes": "TODO: set the real Gmail OAuth2 credential. Polling every minute to start -- widen the interval once this is stable to reduce API usage. n8n's Gmail Trigger dedupes on message ID between polls by default, so re-processing the same message on every poll shouldn't happen, but worth confirming in testing."
    },
    {
      "parameters": {
        "jsCode": "// Extracts the fields the rest of the Phase 7 chain needs.\n// CONFIRMED real shape (via live test): n8n's Gmail Trigger here returns a\n// pre-parsed email object (MIME-parsed), not the raw Gmail API payload.headers/parts\n// structure originally assumed. Real fields: text, html, subject, from.value[0].address,\n// to.value[0].address, id, threadId.\nconst msg = $json;\n\nconst fromEmail = (msg.from && msg.from.value && msg.from.value[0] && msg.from.value[0].address) || '';\nconst toEmail = (msg.to && msg.to.value && msg.to.value[0] && msg.to.value[0].address) || '';\nconst subject = msg.subject || '';\n\n// Prefer plain text; fall back to a crude HTML strip if only html is present.\nlet body = msg.text || '';\nif (!body && msg.html) {\n  body = msg.html.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nconst gmailMessageId = msg.id || msg.messageId || '';\nconst gmailThreadId = msg.threadId || gmailMessageId;\n\nreturn [{\n  json: {\n    gmail_message_id: gmailMessageId,\n    gmail_thread_id: gmailThreadId,\n    from_email: fromEmail,\n    to_email: toEmail,\n    subject,\n    body\n  }\n}];"
      },
      "id": "120df9b8-0e94-4ecf-9da5-6ffc002ba5ad",
      "name": "Extract Email Fields",
      "type": "n8n-nodes-base.code",
