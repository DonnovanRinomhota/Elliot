      "notes": "Uses the approved 'elliot_alert' template, so it arrives even when you haven't written to Elliot's number in the last 24 hours.",
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Meta answers { messages: [{ id }] } when it accepted the template message.\nconst r = $json;\nconst a = $('Is Email?').item.json;\nconst status = Number(r.statusCode || 0);\nlet body = r.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { /* not JSON */ } }\nconst err = body && typeof body === 'object' ? body.error : null;\nconst ok = status >= 200 && status < 300 && !err;\nlet detail = '';\nif (!ok) {\n  detail = err ? `${err.message || 'refused'}${err.code ? ` (code ${err.code})` : ''}`\n    : (r.error && !status ? (r.error.message || String(r.error)) : `HTTP ${status || 'no response'}`);\n  if (err && Number(err.code) === 132001) detail += ' -- create the \"elliot_alert\" template in WhatsApp Manager';\n  if (err && Number(err.code) === 131030) detail += ' -- on the test number, add this phone as an allowed recipient';\n}\nreturn { json: { channel: 'whatsapp', recipient: a.recipient, ok, detail: String(detail).slice(0, 300) } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "43f6db9f-78cd-597d-ae2d-27b83ffd52c8",
      "name": "Check WhatsApp Result",
