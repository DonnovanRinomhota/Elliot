    {
      "parameters": {
        "jsCode": "// The Gmail fallback after Resend failed.\nconst r = $json;\nconst prev = $('Check Email Result').item.json;\nconst status = Number(r.statusCode || 0);\nconst ok = status >= 200 && status < 300;\nlet reason = '';\nif (!ok) {\n  let body = r.body;\n  if (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { /* not JSON */ } }\n  reason = r.error && !status ? (r.error.message || String(r.error))\n    : `HTTP ${status || 'no response'}${body && body.error && body.error.message ? ': ' + body.error.message : ''}`;\n}\nreturn { json: {\n  channel: 'email',\n  recipient: prev.recipient,\n  ok,\n  detail: ok ? `via Gmail (${prev.detail})` : `${prev.detail}; Gmail: ${String(reason).slice(0, 150)}`,\n} };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "2feeaef7-bb6a-572f-a49e-27572c7ddc6a",
      "name": "Check Gmail Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
