      "id": "c7545e2a-09ae-5215-8107-907058c5179d",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        -120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_SET_ON_IMPORT",
          "name": "Resend API key"
        }
      },
      "notes": "Resend sends from alerts@getelliot.eu, so alerts still arrive when Gmail is what broke. Not set up yet = falls back to Gmail.",
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// One alert per item. Resend answers { id } when it accepted the email.\n// If Resend isn't set up yet or refused it, fall back to Gmail -- unless\n// Gmail is what's broken, in which case WhatsApp is the other route.\nconst r = $json;\nconst a = $('Is Email?').item.json;\nconst status = Number(r.statusCode || 0);\nlet body = r.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { /* not JSON */ } }\nconst ok = status >= 200 && status < 300 && body && body.id;\nlet why = '';\nif (!ok) {\n  if (r.error && !status) why = typeof r.error === 'object' ? (r.error.message || 'request failed') : String(r.error);\n  else why = `HTTP ${status || 'no response'}${body && body.message ? ': ' + body.message : ''}`;\n}\nconst b64 = (s) => Buffer.from(String(s), 'utf8').toString('base64');\nconst raw = [\n  `To: ${a.recipient}`,\n  `Subject: =?UTF-8?B?${b64(a.subject)}?=`,\n  'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=UTF-8',\n  'Content-Transfer-Encoding: base64',\n].join('\\r\\n') + '\\r\\n\\r\\n' + b64(String(a.body || a.short || '') + '\\n');\nreturn { json: {\n  channel: 'email',\n  recipient: a.recipient,\n  ok: !!ok,\n  detail: ok ? 'via Resend' : `Resend: ${String(why).slice(0, 150)}`,\n  raw_message: Buffer.from(raw).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, ''),\n} };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "cf577c9b-443b-5ce3-af62-bb63806a83b1",
      "name": "Check Email Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        -120
      ]
