    {
      "parameters": {
        "jsCode": "// Turns each check's HTTP answer into { key, label, ok, detail }.\n// Every check node has \"continue on error\" + full response, so a dead\n// service, an expired login or a missing credential shows up here as a\n// failure instead of stopping the workflow.\nfunction get(name) {\n  try { return $(name).first().json; } catch (e) { return null; }\n}\nfunction parse(body) {\n  if (typeof body !== 'string') return body;\n  try { return JSON.parse(body); } catch (e) { return body; }\n}\nfunction message(body) {\n  const b = parse(body);\n  if (!b) return '';\n  if (typeof b === 'string') return b.slice(0, 160);\n  const e = b.error;\n  if (e && typeof e === 'object') return String(e.message || e.status || JSON.stringify(e)).slice(0, 160);\n  return String(e || b.error_description || b.detail || b.message || '').slice(0, 160);\n}\nfunction judge(key, label, nodeName, opts = {}) {\n  const r = get(nodeName);\n  if (!r) return { key, label, ok: false, detail: 'the check did not run' };\n  if (r.error && !r.statusCode) {\n    const m = typeof r.error === 'object' ? (r.error.message || JSON.stringify(r.error)) : String(r.error);\n    return { key, label, ok: false, detail: m.slice(0, 200) };\n  }\n  const status = Number(r.statusCode || 0);\n  if (status >= 200 && status < 300) return { key, label, ok: true, detail: '' };\n  if (opts.okStatuses && opts.okStatuses.includes(status)) return { key, label, ok: true, detail: `busy (HTTP ${status})` };\n  const m = message(r.body);\n  const hint = opts.hints && opts.hints[status] ? ` -- ${opts.hints[status]}` : '';\n  return { key, label, ok: false, detail: `HTTP ${status || 'no response'}${m ? ': ' + m : ''}${hint}` };\n}\n\nconst results = [];\nconst settings = get('Load Alert Settings') || {};\nif (settings.error && !('whatsapp_sender_id' in settings)) {\n  const m = typeof settings.error === 'object' ? settings.error.message : String(settings.error);\n  results.push({ key: 'database', label: 'Database (Supabase)', ok: false, detail: String(m).slice(0, 200) });\n} else {\n  results.push({ key: 'database', label: 'Database (Supabase)', ok: true, detail: '' });\n}\nresults.push(judge('claude', 'Claude (Elliot\\'s replies)', 'Check Claude', {\n  okStatuses: [429, 529],\n  hints: { 401: 'the API key was rejected; put a valid key in n8n\\'s \"Anthropic account\" credential',\n           400: 'often means the Claude credit balance has run out' },\n}));\nresults.push(judge('voyage', 'Voyage AI (knowledge search)', 'Check Voyage', {\n  okStatuses: [429],\n  hints: { 401: 'the Voyage API key was rejected' },\n}));\nresults.push(judge('gmail', 'Gmail (email replies and notifications)', 'Check Gmail', {\n  hints: { 401: 'the Gmail login has expired; reconnect \"Gmail account\" in n8n' },\n}));\nresults.push(judge('calendar', 'Google Calendar (viewings)', 'Check Calendar', {\n  hints: { 401: 'the Calendar login has expired; reconnect \"Elliot Google Calendar\" in n8n' },\n}));\nif (settings.whatsapp_check_id) {\n  results.push(judge('whatsapp', 'WhatsApp (Meta)', 'Check WhatsApp', {\n    hints: { 401: 'the WhatsApp token has expired or was revoked; update \"WhatsApp Cloud API token\" in n8n' },\n  }));\n}\nreturn [{ json: { results, results_json: JSON.stringify(results) } }];\n"
      },
